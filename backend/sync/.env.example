# WebSocket server configuration
WS_HOST=0.0.0.0
WS_PORT=8080

# Session TTL in milliseconds (2 hours)
SESSION_TTL_MS=7200000

# Throttling interval for high-frequency playback updates (ms)
PLAYHEAD_THROTTLE_MS=33

# Ping interval for keepalive (ms)
PING_INTERVAL_MS=30000

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Prometheus metrics endpoint: true/false
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Health check endpoint: true/false
HEALTH_ENABLED=true
HEALTH_PATH=/health
