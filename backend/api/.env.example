# LiveSession website API configuration
NODE_ENV=development

# HTTP port (internal, behind nginx)
PORT=3001

# Must change in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# PostgreSQL connection string
DATABASE_URL=postgres://livesession:livesession@db:5432/livesession

# Auth cookie name
COOKIE_NAME=livesession_auth

# Admin bootstrap credentials (used by migration 002_seed_admin)
ADMIN_EMAIL=admin@livesession.local
ADMIN_PASSWORD=admin123

# Device login code TTL (ms) and login page URL origin
DEVICE_CODE_TTL_MS=300000
WEB_ORIGIN=http://151.245.217.113
